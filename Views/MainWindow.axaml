<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CareFlow.ViewModels"
        x:Class="CareFlow.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CareFlow - Diagnostic Booking Management"
        Width="950"
        Height="800"
        MinWidth="750"
        MinHeight="550">

	<Grid Margin="28"
          RowDefinitions="Auto,Auto,*">

		<StackPanel Grid.Row="0" Spacing="4">
			<TextBlock Text="CareFlow"
                       FontSize="30"
                       FontWeight="Bold"/>

			<TextBlock Text="Diagnostic Booking Management"
                       Opacity="0.7"/>
		</StackPanel>

		<Border Grid.Row="1"
                Background="#E8F1FA"
                CornerRadius="8"
                Padding="12"
                Margin="0,18,0,18">

			<TextBlock Text="{Binding Message}"
                       Foreground="#234568"
                       TextWrapping="Wrap"/>
		</Border>

		<ScrollViewer Grid.Row="2">
			<StackPanel Spacing="20">

				<!-- Booking Form -->
				<StackPanel Spacing="16">

					<TextBlock Text="New Diagnostic Booking"
                               FontSize="22"
                               FontWeight="SemiBold"/>

					<StackPanel Spacing="6">
						<TextBlock Text="Select Patient"
                                   FontWeight="SemiBold"/>

						<ComboBox ItemsSource="{Binding Patients}"
                                  SelectedItem="{Binding SelectedPatient}"
                                  PlaceholderText="Choose an existing patient">

							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding FullName}"/>
								</DataTemplate>
							</ComboBox.ItemTemplate>

						</ComboBox>
					</StackPanel>

					<StackPanel Spacing="6">
						<TextBlock Text="Appointment Date"
                                   FontWeight="SemiBold"/>

						<TextBox Text="{Binding AppointmentDate}"
                                 PlaceholderText="YYYY-MM-DD"/>

						<Button Content="Check Availability"
                                Command="{Binding CheckAvailabilityCommand}"
                                HorizontalAlignment="Left"
                                Padding="18,10"
                                Margin="0,8,0,0"/>
					</StackPanel>

					<StackPanel Spacing="10">
						<TextBlock Text="Select Diagnostic Services (1–3)"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

						<ItemsControl ItemsSource="{Binding Services}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border BorderBrush="#D5DCE5"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,0,0,8">

										<StackPanel Spacing="4">
											<CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected}"/>

											<TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Opacity="0.7"
                                                       Margin="24,0,0,0"/>

											<TextBlock Text="{Binding AvailabilityText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Margin="24,4,0,0"/>
										</StackPanel>

									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<Button Content="CONFIRM BOOKING"
                            Command="{Binding CreateBookingCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="18,14"
                            FontSize="16"
                            FontWeight="Bold"/>

					<Button Content="Refresh Data"
                            Command="{Binding ReloadDataCommand}"
                            HorizontalAlignment="Left"
                            Padding="18,10"/>

				</StackPanel>

				<Separator/>

				<!-- Confirmed Bookings -->
				<StackPanel Spacing="12">

					<TextBlock Text="Confirmed Bookings"
                               FontSize="22"
                               FontWeight="SemiBold"/>

					<TextBlock Text="Previously confirmed diagnostic appointments."
                               Opacity="0.7"/>

					<ItemsControl ItemsSource="{Binding ConfirmedBookings}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>

								<Border BorderBrush="#D5DCE5"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,8">

									<StackPanel Spacing="5">

										<TextBlock Text="{Binding PatientName}"
                                                   FontWeight="Bold"
                                                   FontSize="16"/>

										<TextBlock Text="{Binding AppointmentDate, StringFormat='Appointment: {0:MMMM dd, yyyy}'}"/>

										<TextBlock Text="{Binding Services, StringFormat='Services: {0}'}"
                                                   TextWrapping="Wrap"/>

										<TextBlock Text="{Binding BookingId, StringFormat='Booking Reference: #{0}'}"
                                                   FontSize="12"
                                                   Opacity="0.7"/>

									</StackPanel>

								</Border>

							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

				</StackPanel>

			</StackPanel>
		</ScrollViewer>

	</Grid>

</Window>
